import { useEffect, useState } from 'react'
import { supabase } from './lib/supabase'

export default function Auth({ onAuthenticated }) {
  const [modo, setModo] = useState('login')
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [nombre, setNombre] = useState('')
  const [cargando, setCargando] = useState(false)
  const [error, setError] = useState('')
  const [mensaje, setMensaje] = useState('')

  useEffect(() => {
    verificarSesion()
  }, [])

  async function verificarSesion() {
    const { data, error } = await supabase.auth.getSession()

    if (error) {
      console.error('Error obteniendo sesión:', error)
      return
    }

    if (data.session?.user) {
      await cargarUsuario(data.session.user)
    }
  }

  async function cargarUsuario(authUser) {
    setError('')

    console.log('AUTH USER:')
    console.log(authUser)
    console.log('AUTH USER ID:', authUser.id)

    // ============================================================
    // BUSCAR USUARIO INTERNO
    // ============================================================

    const {
      data: usuario,
      error: errorUsuario
    } = await supabase
      .from('usuarios')
      .select(`
        id,
        nombre,
        email,
        auth_user_id,
        rol_id,
        roles (
          id,
          nombre
        )
      `)
      .eq('auth_user_id', authUser.id)
      .maybeSingle()

    console.log('USUARIO DB:', usuario)
    console.log('ERROR USUARIO:', errorUsuario)

    if (errorUsuario) {
      console.error(
        'Error buscando usuario interno:',
        errorUsuario
      )
    }

    if (usuario) {
      console.log('USUARIO INTERNO ENCONTRADO')
      console.log('ROL:', usuario.roles?.nombre)

      onAuthenticated({
        authUser,
        tipo: 'usuario',
        usuario
      })

      return
    }

    // ============================================================
    // BUSCAR CLIENTE
    // ============================================================

    const {
      data: cliente,
      error: errorCliente
    } = await supabase
      .from('clientes')
      .select(`
        id,
        nombre,
        telefono,
        whatsapp,
        email,
        direccion,
        ciudad,
        observaciones,
        auth_user_id,
        tipo_cliente
      `)
      .eq('auth_user_id', authUser.id)
      .maybeSingle()

    console.log('CLIENTE DB:', cliente)
    console.log('ERROR CLIENTE:', errorCliente)

    if (errorCliente) {
      console.error(
        'Error buscando cliente:',
        errorCliente
      )

      setError(
        'No se pudo cargar el perfil del cliente.'
      )

      return
    }

    if (cliente) {
      onAuthenticated({
        authUser,
        tipo: 'cliente',
        cliente
      })

      return
    }

    setError(
      'La cuenta existe, pero todavía no está vinculada al sistema.'
    )
  }

  async function iniciarSesion(e) {
    e.preventDefault()

    setCargando(true)
    setError('')
    setMensaje('')

    const {
      data,
      error
    } = await supabase.auth.signInWithPassword({
      email,
      password
    })

    if (error) {
      console.error(
        'Error iniciando sesión:',
        error
      )

      setError(error.message)
      setCargando(false)
      return
    }

    if (!data.user) {
      setError('No se pudo iniciar sesión.')
      setCargando(false)
      return
    }

    await cargarUsuario(data.user)

    setCargando(false)
  }

  async function registrarse(e) {
    e.preventDefault()

    setCargando(true)
    setError('')
    setMensaje('')

    const {
      data,
      error
    } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: {
          nombre
        }
      }
    })

    if (error) {
      console.error(
        'Error creando cuenta:',
        error
      )

      setError(error.message)
      setCargando(false)
      return
    }

    if (!data.user) {
      setError('No se pudo crear la cuenta.')
      setCargando(false)
      return
    }

    // ============================================================
    // CONFIRMACIÓN DE EMAIL
    // ============================================================

    if (!data.session) {
      setMensaje(
        'Cuenta creada. Revisá tu email para confirmar la cuenta y luego iniciá sesión.'
      )

      setModo('login')
      setPassword('')
      setCargando(false)

      return
    }

    // ============================================================
    // CREAR CLIENTE
    // ============================================================

    const {
      data: cliente,
      error: errorCliente
    } = await supabase
      .from('clientes')
      .insert({
        auth_user_id: data.user.id,
        nombre,
        email,
        tipo_cliente: 'minorista'
      })
      .select(`
        id,
        nombre,
        email,
        auth_user_id,
        tipo_cliente
      `)
      .single()

    if (errorCliente) {
      console.error(
        'Error creando cliente:',
        errorCliente
      )

      setError(
        'La cuenta se creó, pero no se pudo crear el perfil del cliente.'
      )

      setCargando(false)

      return
    }

    onAuthenticated({
      authUser: data.user,
      tipo: 'cliente',
      cliente
    })

    setCargando(false)
  }

  return (
    <div className="auth-container">

      <div className="auth-card">

        <div className="auth-logo">
          <h1>Sistema de Pedidos</h1>
          <p>Pedidos personalizados</p>
        </div>

        {modo === 'login' ? (

          <form onSubmit={iniciarSesion}>

            <h2>Iniciar sesión</h2>

            {error && (
              <div className="auth-error">
                {error}
              </div>
            )}

            {mensaje && (
              <div className="auth-success">
                {mensaje}
              </div>
            )}

            <label>
              <span>Email</span>

              <input
                type="email"
                value={email}
                onChange={(e) =>
                  setEmail(e.target.value)
                }
                placeholder="tu@email.com"
                required
              />
            </label>

            <label>
              <span>Contraseña</span>

              <input
                type="password"
                value={password}
                onChange={(e) =>
                  setPassword(e.target.value)
                }
                placeholder="••••••••"
                required
              />
            </label>

            <button
              type="submit"
              disabled={cargando}
            >
              {cargando
                ? 'Ingresando...'
                : 'Iniciar sesión'}
            </button>

            <button
              type="button"
              className="auth-secondary"
              onClick={() => {
                setModo('registro')
                setError('')
                setMensaje('')
              }}
            >
              Crear una cuenta
            </button>

          </form>

        ) : (

          <form onSubmit={registrarse}>

            <h2>Crear cuenta</h2>

            {error && (
              <div className="auth-error">
                {error}
              </div>
            )}

            {mensaje && (
              <div className="auth-success">
                {mensaje}
              </div>
            )}

            <label>
              <span>Nombre</span>

              <input
                type="text"
                value={nombre}
                onChange={(e) =>
                  setNombre(e.target.value)
                }
                placeholder="Tu nombre"
                required
              />
            </label>

            <label>
              <span>Email</span>

              <input
                type="email"
                value={email}
                onChange={(e) =>
                  setEmail(e.target.value)
                }
                placeholder="tu@email.com"
                required
              />
            </label>

            <label>
              <span>Contraseña</span>

              <input
                type="password"
                value={password}
                onChange={(e) =>
                  setPassword(e.target.value)
                }
                placeholder="Mínimo 6 caracteres"
                minLength={6}
                required
              />
            </label>

            <button
              type="submit"
              disabled={cargando}
            >
              {cargando
                ? 'Creando cuenta...'
                : 'Crear cuenta'}
            </button>

            <button
              type="button"
              className="auth-secondary"
              onClick={() => {
                setModo('login')
                setError('')
                setMensaje('')
              }}
            >
              Ya tengo una cuenta
            </button>

          </form>

        )}

      </div>

    </div>
  )
}
