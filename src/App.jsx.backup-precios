   FORMULARIO PERSONALIZACIÓN
   ============================================================ */

function FormularioPersonalizacion({
  productoId,
  tipos,
  guardar,
  cancelar
}) {

  const [tipoId, setTipoId] = useState('')
  const [guardando, setGuardando] = useState(false)


  async function enviar(e) {

    e.preventDefault()

    if (!tipoId) {
      alert('Seleccioná un tipo de personalización.')
      return
    }

    setGuardando(true)


    const { error } = await supabase
      .from('producto_personalizaciones')
      .insert({
        producto_id: productoId,
        tipo_personalizacion_id: Number(tipoId),
        activo: true
      })


    setGuardando(false)


    if (error) {

      if (error.code === '23505') {
        alert(
          'Esta personalización ya está agregada al producto.'
        )
      } else {
        console.error(error)
        alert('No se pudo guardar.')
      }

      return
    }


    guardar()

  }


  return (

    <form
      className="formulario"
      onSubmit={enviar}
    >

      <label>

        <span>
          Tipo de personalización
        </span>

        <select
          value={tipoId}
          onChange={(e) => setTipoId(e.target.value)}
        >

          <option value="">
            Seleccionar...
          </option>

          {tipos.map((tipo) => (

            <option
              key={tipo.id}
              value={tipo.id}
            >
              {tipo.nombre}
            </option>

          ))}

        </select>

      </label>


      <div className="modal-botones">

        <button
          type="button"
          className="boton-cancelar"
          onClick={cancelar}
        >
          Cancelar
        </button>

        <button
          type="submit"
          className="boton-guardar"
          disabled={guardando}
        >
          <Save size={17} />

          {guardando
            ? 'Guardando...'
            : 'Agregar'}

        </button>

      </div>

    </form>

  )
}


/* ============================================================
   FORMULARIO PREGUNTA
   ============================================================ */

function FormularioPregunta({
  productoId,
  guardar,
  cancelar
}) {

  const [form, setForm] = useState({
    titulo: '',
    descripcion: '',
    tipo_respuesta: 'texto',
    placeholder: '',
    permite_archivo: false,
    permite_multiple: false,
    obligatoria: false,
    orden: 0
  })

  const [guardando, setGuardando] = useState(false)


  function cambiar(campo, valor) {

    setForm({
      ...form,
      [campo]: valor
    })

  }


  async function enviar(e) {

    e.preventDefault()


    if (!form.titulo.trim()) {

      alert('Escribí la pregunta.')

      return

    }


    setGuardando(true)


    const { data: pregunta, error: errorPregunta } =
      await supabase
        .from('preguntas')
        .insert({
          titulo: form.titulo,
          descripcion: form.descripcion || null,
          tipo_respuesta: form.tipo_respuesta,
          placeholder: form.placeholder || null,
          permite_archivo: form.permite_archivo,
          permite_multiple: form.permite_multiple,
          activo: true
        })
        .select()
        .single()


    if (errorPregunta) {

      console.error(errorPregunta)

      alert('No se pudo crear la pregunta.')

      setGuardando(false)

      return

    }


    const { error: errorRelacion } =
      await supabase
        .from('producto_preguntas')
        .insert({
          producto_id: productoId,
          pregunta_id: pregunta.id,
          orden: Number(form.orden) || 0,
          obligatoria: form.obligatoria,
          activo: true
        })


    if (errorRelacion) {

      console.error(errorRelacion)

      alert(
        'La pregunta se creó, pero no se pudo asociar al producto.'
      )

      setGuardando(false)

      return

    }


    setGuardando(false)

    guardar()

  }


  return (

    <form
      className="formulario"
      onSubmit={enviar}
    >

      <Campo
        label="Pregunta *"
        value={form.titulo}
        onChange={(v) => cambiar('titulo', v)}
        placeholder="Ej: ¿Qué nombre querés colocar?"
      />


      <Campo
        label="Descripción"
        value={form.descripcion}
        onChange={(v) => cambiar('descripcion', v)}
        placeholder="Información adicional para el cliente"
      />


      <label>

        <span>
          Tipo de respuesta
        </span>

        <select
          value={form.tipo_respuesta}
          onChange={(e) =>
            cambiar('tipo_respuesta', e.target.value)
          }
        >

          <option value="texto">
            Texto
          </option>

          <option value="numero">
            Número
          </option>

          <option value="booleano">
            Sí / No
          </option>

          <option value="opcion">
            Selección
          </option>

        </select>

      </label>


      <Campo
        label="Texto de ayuda"
        value={form.placeholder}
        onChange={(v) => cambiar('placeholder', v)}
        placeholder="Ej: Escribí el nombre"
      />


      <Campo
        label="Orden"
        type="number"
        value={form.orden}
        onChange={(v) => cambiar('orden', v)}
        placeholder="0"
      />


      <div className="checks">

        <label className="check">

          <input
            type="checkbox"
            checked={form.obligatoria}
            onChange={(e) =>
              cambiar('obligatoria', e.target.checked)
            }
          />

          <span>
            Pregunta obligatoria
          </span>

        </label>


        <label className="check">

          <input
            type="checkbox"
            checked={form.permite_archivo}
            onChange={(e) =>
              cambiar(
                'permite_archivo',
                e.target.checked
              )
            }
          />

          <span>
            Permitir archivo
          </span>

        </label>


        <label className="check">

          <input
            type="checkbox"
            checked={form.permite_multiple}
            onChange={(e) =>
              cambiar(
                'permite_multiple',
                e.target.checked
              )
            }
          />

          <span>
            Permitir múltiples respuestas
          </span>

        </label>

      </div>


      <div className="modal-botones">

        <button
          type="button"
          className="boton-cancelar"
          onClick={cancelar}
        >
          Cancelar
        </button>

        <button
          type="submit"
          className="boton-guardar"
          disabled={guardando}
        >
          <Save size={17} />

          {guardando
            ? 'Guardando...'
            : 'Crear pregunta'}

        </button>

      </div>

    </form>

  )
}


/* ============================================================
   COMPONENTES AUXILIARES
   ============================================================ */

function Campo({
  label,
  value,
  onChange,
  placeholder,
  type = 'text'
}) {

  return (

    <label>

      <span>{label}</span>

      <input
        type={type}
        value={value}
        placeholder={placeholder}
        onChange={(e) => onChange(e.target.value)}
      />

    </label>

  )
}


function Modal({ titulo, cerrar, children }) {

  return (

    <div className="modal-fondo">

      <div className="modal">

        <div className="modal-header">

          <h2>{titulo}</h2>

          <button
            className="modal-cerrar"
            onClick={cerrar}
          >
            <X size={20} />
          </button>

        </div>

        {children}

      </div>

    </div>

  )
}


export default App
