/* ============================================================
   DETALLE DEL PRODUCTO
   ============================================================ */

function ProductoDetalle({ producto, volver }) {

  const [variantes, setVariantes] = useState([])
  const [personalizaciones, setPersonalizaciones] = useState([])
  const [preguntas, setPreguntas] = useState([])
  const [tiposPersonalizacion, setTiposPersonalizacion] = useState([])

  const [mostrarVariante, setMostrarVariante] = useState(false)
  const [mostrarPersonalizacion, setMostrarPersonalizacion] = useState(false)
  const [mostrarPregunta, setMostrarPregunta] = useState(false)

  const [editandoVariante, setEditandoVariante] = useState(null)

  useEffect(() => {
    cargarTodo()
  }, [producto.id])

  async function cargarTodo() {
    await Promise.all([
      cargarVariantes(),
      cargarPersonalizaciones(),
      cargarPreguntas(),
      cargarTiposPersonalizacion()
    ])
  }


  async function cargarVariantes() {

    const { data, error } = await supabase
      .from('producto_variantes')
      .select('*')
      .eq('producto_id', producto.id)
      .eq('activo', true)
      .order('id')

    if (error) {
      console.error(error)
      return
    }

    setVariantes(data || [])
  }


  async function cargarTiposPersonalizacion() {

    const { data, error } = await supabase
      .from('tipos_personalizacion')
      .select('*')
      .eq('activo', true)
      .order('id')

    if (error) {
      console.error(error)
      return
    }

    setTiposPersonalizacion(data || [])
  }


  async function cargarPersonalizaciones() {

    const { data, error } = await supabase
      .from('producto_personalizaciones')
      .select(`
        *,
        tipos_personalizacion (
          nombre,
          descripcion
        )
      `)
      .eq('producto_id', producto.id)
      .eq('activo', true)
      .order('id')

    if (error) {
      console.error(error)
      return
    }

    setPersonalizaciones(data || [])
  }


  async function cargarPreguntas() {

    const { data, error } = await supabase
      .from('producto_preguntas')
      .select(`
        *,
        preguntas (
          id,
          titulo,
          descripcion,
          tipo_respuesta,
          placeholder,
          permite_archivo,
          permite_multiple,
          activo
        )
      `)
      .eq('producto_id', producto.id)
      .eq('activo', true)
      .order('orden')

    if (error) {
      console.error(error)
      return
    }

    setPreguntas(data || [])
  }


  async function eliminarVariante(id) {

    const confirmar = window.confirm(
      '¿Seguro que querés eliminar esta variante?'
    )

    if (!confirmar) return

    const { error } = await supabase
      .from('producto_variantes')
      .update({ activo: false })
      .eq('id', id)

    if (error) {
      alert('No se pudo eliminar la variante.')
      console.error(error)
      return
    }

    cargarVariantes()
  }


  async function eliminarPersonalizacion(id) {

    const confirmar = window.confirm(
      '¿Eliminar esta personalización?'
    )

    if (!confirmar) return

    const { error } = await supabase
      .from('producto_personalizaciones')
      .update({ activo: false })
      .eq('id', id)

    if (error) {
      alert('No se pudo eliminar.')
      return
    }

    cargarPersonalizaciones()
  }


  async function eliminarPregunta(id) {

    const confirmar = window.confirm(
      '¿Eliminar esta pregunta?'
    )

    if (!confirmar) return

    const { error } = await supabase
      .from('producto_preguntas')
      .update({ activo: false })
      .eq('id', id)

    if (error) {
      alert('No se pudo eliminar.')
      return
    }

    cargarPreguntas()
  }


  return (
    <>
      <header className="topbar">

        <div>

          <button
            className="boton-volver"
            onClick={volver}
          >
            <ArrowLeft size={18} />
            Volver a productos
          </button>

          <h1>{producto.nombre}</h1>

          <p>
            Configuración completa del producto.
          </p>

        </div>

      </header>


      <section className="detalle-producto">

        <div className="detalle-imagen">

          {producto.imagen_principal ? (
            <img
              src={producto.imagen_principal}
              alt={producto.nombre}
            />
          ) : (
            <Package size={70} />
          )}

        </div>


        <div className="detalle-informacion">

          <span className="producto-categoria">
            {producto.categorias?.nombre || 'Sin categoría'}
          </span>

          <h2>
            {producto.nombre}
          </h2>

          <p className="detalle-descripcion">
            {producto.descripcion || 'Sin descripción'}
          </p>


          <div className="detalle-datos">

            <div>
              <span>Código interno</span>
              <strong>
                {producto.codigo_interno || 'Sin código'}
              </strong>
            </div>

            <div>
              <span>Precio</span>
              <strong>
                {producto.precio
                  ? `$ ${producto.precio}`
                  : 'Sin precio'}
              </strong>
            </div>

            <div>
              <span>Estado</span>
              <strong>
                {producto.activo ? 'Activo' : 'Inactivo'}
              </strong>
            </div>

          </div>

        </div>

      </section>


      {/* ======================================================
          VARIANTES
          ====================================================== */}

      <section className="panel detalle-panel">

        <div className="panel-header">

          <div>
            <h2>Variantes</h2>

            <p>
              Presentaciones, colores, talles y modelos.
            </p>
          </div>

          <button
            className="boton-secundario"
            onClick={() => {
              setEditandoVariante(null)
              setMostrarVariante(true)
            }}
          >
            <Plus size={17} />
            Agregar variante
          </button>

        </div>


        {variantes.length === 0 ? (

          <div className="seccion-vacia">

            <Package size={30} />

            <span>
              Todavía no hay variantes configuradas.
            </span>

          </div>

        ) : (

          <div className="tabla">

            <div className="tabla-cabeza">

              <span>Nombre</span>
              <span>SKU</span>
              <span>Color</span>
              <span>Capacidad</span>
              <span>Precio</span>
              <span>Stock</span>
              <span></span>

            </div>


            {variantes.map((variante) => (

              <div
                className="tabla-fila"
                key={variante.id}
              >

                <strong>
                  {variante.nombre}
                </strong>

                <span>
                  {variante.sku || '-'}
                </span>

                <span>
                  {variante.color || '-'}
                </span>

                <span>
                  {variante.capacidad || '-'}
                </span>

                <span>
                  {variante.precio
                    ? `$ ${variante.precio}`
                    : '-'}
                </span>

                <span>
                  {variante.stock ?? '-'}
                </span>

                <div className="acciones">

                  <button
                    onClick={() => {
                      setEditandoVariante(variante)
                      setMostrarVariante(true)
                    }}
                    title="Editar"
                  >
                    <Pencil size={16} />
                  </button>

                  <button
                    onClick={() =>
                      eliminarVariante(variante.id)
                    }
                    title="Eliminar"
                  >
                    <Trash2 size={16} />
                  </button>

                </div>

              </div>

            ))}

          </div>

        )}

      </section>


      {/* ======================================================
          PERSONALIZACIONES
          ====================================================== */}

      <section className="panel detalle-panel">

        <div className="panel-header">

          <div>

            <h2>Personalizaciones</h2>

            <p>
              Qué tipos de personalización admite este producto.
            </p>

          </div>

          <button
            className="boton-secundario"
            onClick={() => setMostrarPersonalizacion(true)}
          >
            <Plus size={17} />
            Agregar
          </button>

        </div>


        {personalizaciones.length === 0 ? (

          <div className="seccion-vacia">

            <Palette size={30} />

            <span>
              Todavía no hay personalizaciones configuradas.
            </span>

          </div>

        ) : (

          <div className="lista-configuracion">

            {personalizaciones.map((item) => (

              <div
                className="configuracion-item"
                key={item.id}
              >

                <div className="configuracion-icono">
                  <Palette size={20} />
                </div>

                <div>

                  <strong>
                    {item.tipos_personalizacion?.nombre}
                  </strong>

                  <span>
                    {item.tipos_personalizacion?.descripcion}
                  </span>

                </div>

                <button
                  onClick={() =>
                    eliminarPersonalizacion(item.id)
                  }
                >
                  <Trash2 size={17} />
                </button>

              </div>

            ))}

          </div>

        )}

      </section>


      {/* ======================================================
          PREGUNTAS
          ====================================================== */}

      <section className="panel detalle-panel">

        <div className="panel-header">

          <div>

            <h2>Preguntas del cliente</h2>

            <p>
              Información que necesitaremos para realizar el pedido.
            </p>

          </div>

          <button
            className="boton-secundario"
            onClick={() => setMostrarPregunta(true)}
          >
            <Plus size={17} />
            Agregar pregunta
          </button>

        </div>


        {preguntas.length === 0 ? (

          <div className="seccion-vacia">

            <ClipboardList size={30} />

            <span>
              Todavía no hay preguntas configuradas.
            </span>

          </div>

        ) : (

          <div className="lista-configuracion">

            {preguntas.map((item) => (

              <div
                className="configuracion-item pregunta-item"
                key={item.id}
              >

                <div className="configuracion-icono">
                  <ClipboardList size={20} />
                </div>

                <div className="pregunta-contenido">

                  <strong>
                    {item.preguntas?.titulo}
                  </strong>

                  <span>
                    Tipo: {item.preguntas?.tipo_respuesta}
                  </span>

                  <div className="etiquetas">

                    {item.obligatoria && (
                      <small>Obligatoria</small>
                    )}

                    {item.preguntas?.permite_archivo && (
                      <small>Permite archivo</small>
                    )}

                    {item.preguntas?.permite_multiple && (
                      <small>Múltiple</small>
                    )}

                  </div>

                </div>

                <button
                  onClick={() =>
                    eliminarPregunta(item.id)
                  }
                >
                  <Trash2 size={17} />
                </button>

              </div>

            ))}

          </div>

        )}

      </section>


      {/* ======================================================
          MODALES
          ====================================================== */}

      {mostrarVariante && (

        <Modal
          titulo={
            editandoVariante
              ? 'Editar variante'
              : 'Nueva variante'
          }
          cerrar={() => {
            setMostrarVariante(false)
            setEditandoVariante(null)
          }}
        >

          <FormularioVariante
            productoId={producto.id}
            variante={editandoVariante}
            guardar={() => {
              setMostrarVariante(false)
              setEditandoVariante(null)
              cargarVariantes()
            }}
            cancelar={() => {
              setMostrarVariante(false)
              setEditandoVariante(null)
            }}
          />

        </Modal>

      )}


      {mostrarPersonalizacion && (

        <Modal
          titulo="Agregar personalización"
          cerrar={() => setMostrarPersonalizacion(false)}
        >

          <FormularioPersonalizacion
            productoId={producto.id}
            tipos={tiposPersonalizacion}
            guardar={() => {
              setMostrarPersonalizacion(false)
              cargarPersonalizaciones()
            }}
            cancelar={() =>
              setMostrarPersonalizacion(false)
            }
          />

        </Modal>

      )}


      {mostrarPregunta && (

        <Modal
          titulo="Nueva pregunta"
          cerrar={() => setMostrarPregunta(false)}
        >

          <FormularioPregunta
            productoId={producto.id}
            guardar={() => {
              setMostrarPregunta(false)
              cargarPreguntas()
            }}
            cancelar={() =>
              setMostrarPregunta(false)
            }
          />

        </Modal>

      )}

    </>
  )
}


/* ============================================================
   FORMULARIO VARIANTE
   ============================================================ */

function FormularioVariante({
  productoId,
  variante,
  guardar,
  cancelar
}) {

  const [form, setForm] = useState({
    nombre: variante?.nombre || '',
    sku: variante?.sku || '',
    color: variante?.color || '',
    talle: variante?.talle || '',
    modelo: variante?.modelo || '',
    capacidad: variante?.capacidad || '',
    precio: variante?.precio || '',
    stock: variante?.stock || ''
  })

  const [guardando, setGuardando] = useState(false)


  function cambiar(campo, valor) {
    setForm({
      ...form,
      [campo]: valor
    })
  }


  async function enviar(e) {

    e.preventDefault()

    if (!form.nombre.trim()) {
      alert('El nombre de la variante es obligatorio.')
      return
    }

    setGuardando(true)

    const datos = {
      producto_id: productoId,
      nombre: form.nombre,
      sku: form.sku || null,
      color: form.color || null,
      talle: form.talle || null,
      modelo: form.modelo || null,
      capacidad: form.capacidad || null,
      precio: form.precio === '' ? null : Number(form.precio),
      stock: form.stock === '' ? null : Number(form.stock),
      activo: true
    }


    let error


    if (variante) {

      const respuesta = await supabase
        .from('producto_variantes')
        .update(datos)
        .eq('id', variante.id)

      error = respuesta.error

    } else {

      const respuesta = await supabase
        .from('producto_variantes')
        .insert(datos)

      error = respuesta.error

    }


    setGuardando(false)


    if (error) {

      console.error(error)

      alert(
        'No se pudo guardar la variante. Revisá la consola.'
      )

      return

    }


    guardar()

  }


  return (

    <form
      className="formulario"
      onSubmit={enviar}
    >

      <Campo
        label="Nombre *"
        value={form.nombre}
        onChange={(v) => cambiar('nombre', v)}
        placeholder="Ej: Taza blanca 11 oz"
      />

      <Campo
        label="SKU"
        value={form.sku}
        onChange={(v) => cambiar('sku', v)}
        placeholder="Ej: TAZ-001-B"
      />


      <div className="form-grid">

        <Campo
          label="Color"
          value={form.color}
          onChange={(v) => cambiar('color', v)}
          placeholder="Ej: Blanco"
        />

        <Campo
          label="Talle"
          value={form.talle}
          onChange={(v) => cambiar('talle', v)}
          placeholder="Ej: M"
        />

      </div>


      <div className="form-grid">

        <Campo
          label="Modelo"
          value={form.modelo}
          onChange={(v) => cambiar('modelo', v)}
          placeholder="Ej: Clásica"
        />

        <Campo
          label="Capacidad"
          value={form.capacidad}
          onChange={(v) => cambiar('capacidad', v)}
          placeholder="Ej: 11 oz"
        />

      </div>


      <div className="form-grid">

        <Campo
          label="Precio"
          type="number"
          value={form.precio}
          onChange={(v) => cambiar('precio', v)}
          placeholder="0"
        />

        <Campo
          label="Stock"
          type="number"
          value={form.stock}
          onChange={(v) => cambiar('stock', v)}
          placeholder="0"
        />

      </div>


      <div className="modal-botones">

        <button
          type="button"
          className="boton-cancelar"
          onClick={cancelar}
        >
          Cancelar
        </button>

        <button
          type="submit"
          className="boton-guardar"
          disabled={guardando}
        >
          <Save size={17} />

          {guardando
            ? 'Guardando...'
            : 'Guardar variante'}

        </button>

      </div>

    </form>

  )
}


