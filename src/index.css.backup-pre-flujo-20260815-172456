* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f5f7fb;
  color: #172033;
}

button {
  font-family: inherit;
  cursor: pointer;
}

.app {
  min-height: 100vh;
  display: flex;
}


/* SIDEBAR */

.sidebar {
  width: 250px;
  background: #ffffff;
  border-right: 1px solid #e8ebf1;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
}

.logo {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px;
  margin-bottom: 38px;
}

.logo-icon {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  background: #111827;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 14px;
}

.logo strong,
.logo span {
  display: block;
}

.logo strong {
  font-size: 16px;
}

.logo span {
  font-size: 12px;
  color: #8a94a6;
  margin-top: 2px;
}


/* MENU */

nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.menu-item {
  border: 0;
  background: transparent;
  color: #6b7280;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 13px;
  border-radius: 9px;
  font-size: 14px;
  text-align: left;
}

.menu-item:hover {
  background: #f5f6f9;
  color: #111827;
}

.menu-item.activo {
  background: #111827;
  color: white;
}

.sidebar-bottom {
  margin-top: auto;
}

.usuario {
  border-top: 1px solid #edf0f4;
  padding: 18px 8px 4px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #e9edf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.usuario strong,
.usuario span {
  display: block;
}

.usuario strong {
  font-size: 13px;
}

.usuario span {
  font-size: 11px;
  color: #8b95a5;
  margin-top: 2px;
}


/* CONTENIDO */

.contenido {
  margin-left: 250px;
  width: calc(100% - 250px);
  padding: 36px 42px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30px;
}

.topbar h1 {
  margin: 0;
  font-size: 26px;
  letter-spacing: -0.5px;
}

.topbar p {
  margin: 7px 0 0;
  color: #8a94a6;
  font-size: 14px;
}

.nuevo-pedido,
.crear {
  border: 0;
  background: #111827;
  color: white;
  border-radius: 9px;
  padding: 11px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  font-size: 13px;
}

.nuevo-pedido:hover,
.crear:hover {
  background: #202938;
}


/* ESTADISTICAS */

.estadisticas {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 24px;
}

.tarjeta {
  background: white;
  border: 1px solid #e8ebf1;
  border-radius: 13px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.tarjeta-icono {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tarjeta-icono.azul {
  background: #eaf2ff;
  color: #3974d9;
}

.tarjeta-icono.violeta {
  background: #f2ecff;
  color: #7a51c7;
}

.tarjeta-icono.naranja {
  background: #fff2e5;
  color: #d77a27;
}

.tarjeta-icono.verde {
  background: #e8f8ef;
  color: #31915b;
}

.tarjeta span {
  display: block;
  font-size: 12px;
  color: #8a94a6;
  margin-bottom: 5px;
}

.tarjeta strong {
  font-size: 24px;
}


/* PANELES */

.grid-principal {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 22px;
}

.panel {
  background: white;
  border: 1px solid #e8ebf1;
  border-radius: 13px;
  min-height: 420px;
}

.panel-header {
  padding: 20px 22px;
  border-bottom: 1px solid #edf0f4;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-header h2 {
  margin: 0;
  font-size: 16px;
}

.panel-header p {
  margin: 5px 0 0;
  color: #929bab;
  font-size: 12px;
}

.ver-todos {
  border: 0;
  background: transparent;
  color: #536071;
  font-size: 12px;
  font-weight: 600;
}


/* VACIO */

.vacio {
  min-height: 340px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px;
}

.vacio-icono {
  width: 62px;
  height: 62px;
  border-radius: 16px;
  background: #f1f3f7;
  color: #7e899b;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 17px;
}

.vacio h3 {
  margin: 0;
  font-size: 15px;
}

.vacio p {
  max-width: 280px;
  color: #929bab;
  font-size: 12px;
  line-height: 1.5;
  margin: 8px 0 18px;
}


/* CATEGORIAS */

.categorias {
  padding: 8px 22px;
}

.categoria {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid #f0f2f5;
}

.categoria:last-child {
  border-bottom: 0;
}

.categoria-icono {
  width: 38px;
  height: 38px;
  background: #f3f5f8;
  color: #657184;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.categoria strong,
.categoria span {
  display: block;
}

.categoria strong {
  font-size: 13px;
}

.categoria span {
  color: #929bab;
  font-size: 11px;
  margin-top: 3px;
}


/* RESPONSIVE */

@media (max-width: 1100px) {
  .estadisticas {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid-principal {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 750px) {
  .sidebar {
    width: 70px;
    padding: 20px 10px;
  }

  .logo div:last-child,
  .menu-item span,
  .usuario div:last-child {
    display: none;
  }

  .logo {
    justify-content: center;
    padding: 0;
  }

  .menu-item {
    justify-content: center;
  }

  .contenido {
    margin-left: 70px;
    width: calc(100% - 70px);
    padding: 25px;
  }

  .estadisticas {
    grid-template-columns: 1fr;
  }

  .topbar {
    align-items: flex-start;
    gap: 15px;
    flex-direction: column;
  }
}
/* ============================================================
   PRODUCTOS
   ============================================================ */

.productos-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}

.buscador {
  width: 360px;
  height: 43px;
  background: white;
  border: 1px solid #e4e8ee;
  border-radius: 9px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  color: #8a94a6;
}

.buscador input {
  border: 0;
  outline: 0;
  width: 100%;
  font-size: 13px;
  background: transparent;
  color: #172033;
}

.cantidad-productos {
  font-size: 13px;
  color: #8a94a6;
}

.productos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.producto-card {
  background: white;
  border: 1px solid #e6eaf0;
  border-radius: 13px;
  overflow: hidden;
  transition: transform 0.15s, box-shadow 0.15s;
}

.producto-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(30, 40, 60, 0.08);
}

.producto-imagen {
  height: 180px;
  background: #f3f5f8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b95a5;
  overflow: hidden;
}

.producto-imagen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.producto-info {
  padding: 17px;
}

.producto-categoria {
  font-size: 11px;
  color: #6c7788;
  background: #f0f2f5;
  border-radius: 5px;
  padding: 4px 7px;
}

.producto-info h3 {
  margin: 11px 0 6px;
  font-size: 16px;
}

.producto-info p {
  margin: 0;
  color: #8a94a6;
  font-size: 12px;
  line-height: 1.5;
  min-height: 36px;
}

.producto-footer {
  margin-top: 15px;
  padding-top: 13px;
  border-top: 1px solid #edf0f4;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #7c8798;
}

.producto-codigo {
  font-size: 11px;
}

.cargando {
  grid-column: 1 / -1;
  text-align: center;
  padding: 70px;
  color: #8a94a6;
}

.sin-productos {
  grid-column: 1 / -1;
  background: white;
  border: 1px solid #e6eaf0;
  border-radius: 13px;
  padding: 70px;
  text-align: center;
  color: #8a94a6;
}

.sin-productos h3 {
  color: #172033;
  margin: 15px 0 5px;
}

.sin-productos p {
  font-size: 13px;
}

.pagina-proximamente {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a94a6;
  text-align: center;
}

.pagina-proximamente h2 {
  color: #172033;
  margin: 15px 0 5px;
}

.pagina-proximamente p {
  font-size: 13px;
}

@media (max-width: 1100px) {
  .productos-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 750px) {
  .productos-toolbar {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .buscador {
    width: 100%;
  }

  .productos-grid {
    grid-template-columns: 1fr;
  }
}
