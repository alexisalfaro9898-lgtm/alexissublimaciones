# Copiar a .env y completar con los valores del proyecto
# (Las variables VITE_* son públicas: llegan al navegador. SUPABASE_SECRET_KEY NO:
#  se usa solo en scripts de servidor, NUNCA en el frontend.)

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU-ANON-KEY
SUPABASE_SECRET_KEY=TU-SERVICE-ROLE-KEY
